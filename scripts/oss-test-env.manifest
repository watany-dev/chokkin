# Per-project test environments for the remove-and-test oracle (#338, #339).
#
# Read by scripts/oss-provision-envs.py (installs into target/oss-envs/<slug>)
# and scripts/oss-remove-and-test.py (--envs: picks the venv, test command and
# PYTHONPATH per project). Provisioning BUILDS AND INSTALLS the analyzed
# projects, i.e. it runs their build backends: same isolation rules as
# `make oss-oracle` (throwaway runner, no credentials).
#
# Tab-separated columns (lines starting with # and blank lines are ignored):
#   slug        directory under target/oss-clones/
#   pythonpath  ':'-separated dirs of the working copy put first on PYTHONPATH,
#               so the mutated copy shadows the installed project
#   install     `uv pip install` arguments, run with cwd = the pristine clone
#               (`-e .` lines in requirement files therefore resolve there; the
#               PYTHONPATH shadowing above is what makes tests see the copy)
#   test        test command; `{python}` is the venv interpreter. `-` = default
#               `{python} -m pytest -q -x`
#
# Requirement files are the project's own pinned test requirements where they
# exist; otherwise the [test] extra or a hand-picked minimal set. Provisioning
# resolves with `--exclude-newer <clone commit date>`.
#
# Deselections in the test column drop only tests that fail on the untouched
# tree in the offline sandbox (`--offline`), so they cannot tell removal apart
# from the environment:
#   urllib3        test_recent_date compares against today's date; the http2
#                  probe thread test and IPv6 servers fail in the sandbox
#   requests       connect-timeout tests need a routable 10.255.255.1; mTLS
#                  pool test needs outside network
#   httpx          proxy_close tests resolve an external host
#   starlette      invalid_dir_permissions expects chmod to bite (runs as root)
#   python-dotenv  permission-error tests expect chmod to bite (runs as root)
#   attrs          mypy / pyright golden-output tests (type-checker version drift)
#   anyio          tests/test_sockets.py resolves "localhost" via getaddrinfo,
#                  which the sandbox resolver refuses inside the namespace
#
# urllib3's `src` cannot be imported from a clean clone: the build writes the
# git-ignored `_version.py`, and provisioning cleans it away. urllib3 has no
# CHK001/CHK006 findings today, so its tests never run.
#
# slug	pythonpath	install	test
requests	src	. pytest pytest-mock pytest-httpbin==2.0.0 httpbin~=0.10.0 trustme PySocks	{python} -m pytest -q -x -k "not (test_connect_timeout or test_total_timeout_connect or test_different_connection_pool_for_mtls_settings)"
urllib3	src	. -r dev-requirements.txt	{python} -m pytest -q -x -k "not (test_http2_probe_blocked_per_thread or test_recent_date or ipv6)"
click	src	. -r requirements/tests.txt	-
jinja	src	. -r requirements/tests.txt	-
werkzeug	src	. -r requirements/tests.txt	-
flask	src	. -r requirements/tests.txt	-
httpx	.	-r requirements.txt	{python} -m pytest -q -x -k "not proxy_close"
starlette	.	-r requirements.txt	{python} -m pytest -q -x -k "not invalid_dir_permissions"
uvicorn	.	.[standard] a2wsgi==1.10.6 wsproto==1.2.0 websockets==12.0 pytest==8.2.2 pytest-mock==3.14.0 trustme==1.1.0 cryptography==42.0.8 httpx==0.27.0 watchgod==0.8.2	-
attrs	src	.[tests]	{python} -m pytest -q -x --ignore=tests/test_mypy.yml --ignore=tests/test_pyright.py
anyio	src	.[test]	{python} -m pytest -q -x --ignore=tests/test_sockets.py
python-dotenv	src	. click ipython pytest sh>=2	{python} -m pytest -q -x -k "not (test_set_key_permission_error or test_set_key_unauthorized_file)"
tenacity	.	. pytest tornado typeguard	-
structlog	src	.[tests]	-
pluggy	src	. pytest	-
typer	.	-r requirements-tests.txt	-
black	src	.[d] pytest pytest-xdist	-
fastapi	.	-r requirements-tests.txt	-
djangorestframework	.	. django>=4.2,<5.1 pytest>=7.0.1,<8.0 pytest-django>=4.5.2,<5.0 importlib-metadata<5.0 coreapi==2.3.1 coreschema==0.0.4 django-filter django-guardian>=2.4.0,<2.5 inflection==0.5.1 markdown>=3.3.7 pygments~=2.17.0 pyyaml	-
django	.	. asgiref sqlparse tblib argon2-cffi bcrypt docutils jinja2 numpy Pillow PyYAML tzdata	{python} tests/runtests.py --noinput --failfast --parallel 1
