# Recall sentinels for scripts/oss-metrics.sh.
#
# In-repo fixtures that chokkin must keep reporting so the recall gate has true
# positives to verify. Measured alongside OSS clones (no network). Every `tp`
# label in scripts/oss-fixtures.labels.tsv must appear in findings or recall fails.
#
# CHK002 sentinels guard against over-suppressing unused dependencies.
# CHK003 sentinels guard against over-suppressing missing dependencies.
#
# Format: slug<TAB>path (path absolute or relative to repo root).
#
# slug<TAB>path
unused_boto3	tests/fixtures/deps/unused_boto3
optional_try_import	tests/fixtures/deps/optional_try_import
missing_yaml	tests/fixtures/deps/missing_yaml
